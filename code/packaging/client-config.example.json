{
  "mode": "workbuddy_local_trial",
  "adapter": "public_sfe",
  "source": "<copy-source-from-bridge>",
  "ledger_instance": "<copy-ledger-from-bridge>",
  "bridge_url": "https://your-authorized-bridge.example",
  "owner": [
    "user-<numeric-sub2api-user-id>",
    "key-<numeric-sub2api-key-id>"
  ],
  "assets_root": "C:/NativeHarness/assets",
  "profile_root": "C:/YourProfiles/profile-created-by-login",
  "accepting_new": false,
  "execution_timeout": 120,
  "cleanup_timeout": 10,
  "bindings": [
    {
      "binding_id": "<matching-binding-a-id>",
      "revision": 1,
      "model_alias": "workbuddy-model-a",
      "native_model": "<first-exact-model-id>"
    },
    {
      "binding_id": "<matching-binding-b-id>",
      "revision": 1,
      "model_alias": "workbuddy-model-b",
      "native_model": "<second-exact-model-id>"
    }
  ]
}
